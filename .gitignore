# Python bytecode & caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
/.venv/
/logs/
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# IDE
.idea/

# CatBoost training artifacts
catboost_info/
**/catboost_info/

# Local datasets and downloaded archives
/data/
/.pumps-and-dumps.json

# Notebook runtime outputs (keep the runnable notebooks themselves)
notebooks/analysis_outputs/

# Image outputs from runs
**/images/

# Paper — keep only the final and highlighted-changes PDFs
paper/*
!paper/access.pdf
!paper/access_highlighted.pdf

# Resources — keep event labels and the historical download universe
resources/*
!resources/pumps.json
!resources/pump_event_evidence.json
!resources/pump_event_exclusions.json
!resources/dropped_pumps.json
!resources/btc_currencies.json

